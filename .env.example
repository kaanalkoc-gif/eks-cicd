# API Key for authentication (defaults to 'dev-key-123' if not set)
API_KEY=dev-key-123

# Database URL
# Local Python (default): SQLite — no extra setup
DATABASE_URL=sqlite:///./app.db
#
# Docker Compose overrides this with PostgreSQL (see docker-compose.yml).
# Manual PostgreSQL (local or cloud):
# DATABASE_URL=postgresql+psycopg://fastapi:fastapi@localhost:5432/fastapi

# Logging level (defaults to 'INFO')
LOG_LEVEL=INFO

# Comma-separated allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# JWT settings (change JWT_SECRET in production)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
